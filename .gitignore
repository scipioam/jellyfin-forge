## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Isolated Jellyfin instances (keep directory placeholders only)
/deploy/docker/dev/config/*
!/deploy/docker/dev/config/.gitkeep
/deploy/docker/dev/cache/*
!/deploy/docker/dev/cache/.gitkeep
/deploy/docker/dev/media/*
!/deploy/docker/dev/media/.gitkeep
__pycache__/

# Local tools and Python bytecode
node_modules/
.venv/
venv/
*.py[cod]

# Developer-specific IDE / OS state
.vs/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db

# Local environment files (keep sanitized examples)
.env.*
!.env.example
!.env.sample

# Test and coverage output
coverage/
playwright-report/
test-results/

# Temporary local working reports (phase reports, notes; not for version control)
/temp/

/deploy/docker/dev/web-entry/

# Production deployment local data (prefer external absolute paths)
/deploy/docker/prod/config/
/deploy/docker/prod/cache/
/deploy/docker/prod/media/
/deploy/docker/prod/web-entry/
/deploy/docker/prod/packages/
/deploy/docker/prod/backups/
