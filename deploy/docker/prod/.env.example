# Linux Docker Compose; remove the second file for AgentBridge-only / API-only use.
COMPOSE_FILE=compose.yaml:compose.web-entry.yaml
# Match this repository's Jellyfin 12.1 baseline. Prefer a verified immutable digest.
JELLYFIN_IMAGE=jellyfin/jellyfin:12.1
# Replace with the numeric IDs of the target non-root service account.
JELLYFIN_UID=REPLACE_WITH_UID
JELLYFIN_GID=REPLACE_WITH_GID
# Absolute paths on the deployment host. Keep config/cache/media separate.
JELLYFIN_CONFIG_DIR=/path/to/jellyfin/config
JELLYFIN_CACHE_DIR=/path/to/jellyfin/cache
JELLYFIN_MEDIA_DIR=/path/to/existing/media
JELLYFIN_WEB_ENTRY_DIR=/path/to/jellyfin/web-entry
JELLYFIN_WEB_PATH=/jellyfin/jellyfin-web
JELLYFIN_BASE_URL=/
# Loopback for a same-host reverse proxy; set a LAN address for direct LAN access.
JELLYFIN_BIND_ADDRESS=127.0.0.1
JELLYFIN_HTTP_PORT=8096
